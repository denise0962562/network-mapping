[Unit]
Description=Validate pgBackRest stanza and WAL archiving
Documentation=https://pgbackrest.org/user-guide.html
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/pgbackrest --stanza=network_mapping check
NoNewPrivileges=true
PrivateTmp=true
